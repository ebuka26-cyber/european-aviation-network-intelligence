/// Measure holding table (Step 3A Section 4.6). Empty, no relationships. Measures are organised in display folders 01 to 06.
table _Measures
	lineageTag: 2af6c248-97aa-4b54-9ab8-04f3d13d0cf1

	/// A01. Eurostat passengers carried at the selected airports (arrivals + departures). Summing airports counts a domestic passenger at both airports. Never add Avinor, Finavia or route passengers.
	measure 'Total Passengers' = SUM ( FactAirportMonthly[PassengersCarried] )
		formatString: #,##0
		displayFolder: 01 Airport Performance
		lineageTag: 7cc2b860-02eb-430d-b4a7-57e54989879a

	/// A02. Total Passengers for the same months one year earlier. DimDate shifted back one year; DimYear filter removed. Blank for 2022 (no 2021 data).
	measure 'Total Passengers PY' =
			CALCULATE (
			    [Total Passengers],
			    DATEADD ( DimDate[Date], -1, YEAR ),
			    REMOVEFILTERS ( DimYear )
			)
		formatString: #,##0
		displayFolder: 01 Airport Performance
		lineageTag: b5c8efbe-a3b9-4e9d-8d63-ff91d7855125

	/// A03. Helper: current passengers on airport-months that also have data one year earlier (like-for-like).
	measure 'Total Passengers LFL' =
			SUMX (
			    SUMMARIZE ( FactAirportMonthly, DimAirport[AirportICAO], DimDate[MonthStart] ),
			    VAR Cur = [Total Passengers]
			    VAR Prev = [Total Passengers PY]
			    RETURN IF ( NOT ISBLANK ( Cur ) && NOT ISBLANK ( Prev ), Cur )
			)
		formatString: #,##0
		displayFolder: 01 Airport Performance
		lineageTag: be000054-6345-47a9-94bc-cace953b8f24

	/// A04. Helper: prior-year passengers on the same airport-months as Total Passengers LFL.
	measure 'Total Passengers PY LFL' =
			SUMX (
			    SUMMARIZE ( FactAirportMonthly, DimAirport[AirportICAO], DimDate[MonthStart] ),
			    VAR Cur = [Total Passengers]
			    VAR Prev = [Total Passengers PY]
			    RETURN IF ( NOT ISBLANK ( Cur ) && NOT ISBLANK ( Prev ), Prev )
			)
		formatString: #,##0
		displayFolder: 01 Airport Performance
		lineageTag: 5c59be15-3eeb-44e3-97f3-05ce23e39dde

	/// A05. Like-for-like year-on-year change in passengers carried (MD-05). Blank for 2022.
	measure 'Passenger Growth YoY %' = DIVIDE ( [Total Passengers LFL] - [Total Passengers PY LFL], [Total Passengers PY LFL] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01 Airport Performance
		lineageTag: 4e9f46dc-3a22-48a2-bd80-466d3fb39942

	/// A07. Eurostat commercial air flights (passenger + all-cargo), arrivals + departures. Sweden Jan-Feb 2022 excluded (under-reported). Not the same figure as Avinor movements.
	measure 'Commercial Flights' =
			CALCULATE (
			    SUM ( FactAirportMonthly[CommercialFlights] ),
			    KEEPFILTERS ( FactAirportMonthly[DQ_SE_JanFeb2022_FlightsSeatsIncomplete] = FALSE () )
			)
		formatString: #,##0
		displayFolder: 01 Airport Performance
		lineageTag: 040ab98f-4d72-41fc-b6f5-f600bf40fb1f

	/// A09. Seats offered on commercial passenger flights, arrivals + departures. Sweden Jan-Feb 2022 excluded (MD-07 option a).
	measure 'Available Seats' =
			CALCULATE (
			    SUM ( FactAirportMonthly[PassengerSeatsAvailable] ),
			    KEEPFILTERS ( FactAirportMonthly[DQ_SE_JanFeb2022_FlightsSeatsIncomplete] = FALSE () )
			)
		formatString: #,##0
		displayFolder: 01 Airport Performance
		lineageTag: e2b12a72-c16c-4649-b56a-30ffccbe8502

	/// A10. Hidden helper: passengers on board on rows valid for load factor. Never shown as a passenger total.
	measure 'Passengers On Board (LF basis)' =
			CALCULATE (
			    SUM ( FactAirportMonthly[PassengersOnBoard] ),
			    KEEPFILTERS ( FactAirportMonthly[DQ_CapacityValidForLoadFactor] = TRUE () )
			)
		formatString: #,##0
		isHidden
		displayFolder: 01 Airport Performance
		lineageTag: b15bc864-010f-4a01-a08c-ff23261d8129

	/// A11. Hidden helper: seats on the same rows valid for load factor.
	measure 'Seats (LF basis)' =
			CALCULATE (
			    SUM ( FactAirportMonthly[PassengerSeatsAvailable] ),
			    KEEPFILTERS ( FactAirportMonthly[DQ_CapacityValidForLoadFactor] = TRUE () )
			)
		formatString: #,##0
		isHidden
		displayFolder: 01 Airport Performance
		lineageTag: 3465ff4b-7979-4d72-91d3-265a6381495c

	/// A12. Passengers on board / seats on the same valid rows (ratio of sums). Excludes rows with DQ_CapacityValidForLoadFactor = FALSE, including Sweden Jan-Feb 2022.
	measure 'Passenger Load Factor' = DIVIDE ( [Passengers On Board (LF basis)], [Seats (LF basis)] )
		formatString: 0.0%
		displayFolder: 01 Airport Performance
		lineageTag: 80fd236f-b6f7-4622-8537-abf640a45c37

	/// R01. Eurostat route passengers carried, one primary report per directed flow and month. Responds to origin, destination, route and date filters; ignores DimAirport (R04 inactive). Confidential Norwegian domestic routes are blank. Not an airport or country total. 2022-2024 only.
	measure 'Network Passengers' =
			CALCULATE (
			    SUM ( FactRouteMonthly[PassengersCarried] ),
			    KEEPFILTERS ( FactRouteMonthly[IsPrimaryReport] = TRUE () )
			)
		formatString: #,##0
		displayFolder: 02 Route Intelligence
		lineageTag: 7d1a3fb3-5409-4c29-80fc-d845174748ed

	/// N01. Avinor terminal passengers: domestic + international + offshore (incl. infants and transfer). Never add to Eurostat passengers. MQN 2024-07 blank.
	measure 'Avinor Terminal Passengers' = SUM ( FactAvinorMonthly[TerminalPax] )
		formatString: #,##0
		displayFolder: 03 Norway (Avinor)
		lineageTag: 0250ce72-949e-4dac-8e69-abdced1d0e86

	/// N02. Avinor passengers on domestic flights (arriving/departing + transfer). A domestic passenger is counted at both airports when airports are summed.
	measure 'Avinor Domestic Passengers' = SUM ( FactAvinorMonthly[DomesticPax] )
		formatString: #,##0
		displayFolder: 03 Norway (Avinor)
		lineageTag: fd03a7fb-52f3-4672-a5b4-f557400a3509

	/// N03. Avinor passengers on international flights (arriving/departing + transfer). Blank, not zero, at airports without international traffic.
	measure 'Avinor International Passengers' = SUM ( FactAvinorMonthly[InternationalPax] )
		formatString: #,##0
		displayFolder: 03 Norway (Avinor)
		lineageTag: b6cf2f31-8155-4211-85ea-34dbd6814092

	/// N07. Avinor commercial movements: domestic + international + offshore (MD-08). Not the same figure as Eurostat Commercial Flights.
	measure 'Avinor Flight Movements' = SUM ( FactAvinorMonthly[CommercialMovements] )
		formatString: #,##0
		displayFolder: 03 Norway (Avinor)
		lineageTag: 7d9dce09-24f3-43cf-bb0f-ce1276ad2b7e

	/// R03. Network passengers on flows that start or end at any airport selected in DimAirport (for example Country = Norway), each flow counted once. Reads the DimAirport selection with VALUES; no relationship used. With no DimAirport filter it equals Network Passengers. Not additive across countries (a cross-border flow touches two). 2022-2024 only.
	measure 'Network Passengers (Selected Airports)' =
			VAR Sel = VALUES ( DimAirport[AirportICAO] )
			RETURN
			    CALCULATE (
			        [Network Passengers],
			        FILTER (
			            ALL ( FactRouteMonthly[OriginAirportICAO], FactRouteMonthly[DestinationAirportICAO] ),
			            FactRouteMonthly[OriginAirportICAO] IN Sel
			                || FactRouteMonthly[DestinationAirportICAO] IN Sel
			        )
			    )
		formatString: #,##0
		displayFolder: 02 Route Intelligence
		lineageTag: 1fe3e46f-6fcb-485e-bbe3-a3f1f5f01a7e

	/// R04. Airport passengers on reported routes: all route rows of the selected reporting airports, as those airports report them (activates R04 with USERELATIONSHIP; no IsPrimaryReport filter). Flows between two selected reporting airports count at both ends. Only the 43 reporting airports have values. Never a network total. 2022-2024 only.
	measure 'Airport Route Passengers (As Reported)' =
			CALCULATE (
			    SUM ( FactRouteMonthly[PassengersCarried] ),
			    USERELATIONSHIP ( DimAirport[AirportICAO], FactRouteMonthly[ReportingAirportICAO] )
			)
		formatString: #,##0
		displayFolder: 02 Route Intelligence
		lineageTag: 641a7f8d-8523-4bad-a54f-038f2bfe02e5

	/// A08. Commercial passenger flights, arrivals + departures. Sweden Jan-Feb 2022 excluded. Part of Commercial Flights: never add the two.
	measure 'Passenger Flights' =
			CALCULATE (
			    SUM ( FactAirportMonthly[PassengerFlights] ),
			    KEEPFILTERS ( FactAirportMonthly[DQ_SE_JanFeb2022_FlightsSeatsIncomplete] = FALSE () )
			)
		formatString: #,##0
		displayFolder: 01 Airport Performance
		lineageTag: c9af74f8-6662-41cd-9f50-2c7ebb732ecd

	/// N04. Share of fixed-wing terminal passengers on international flights: International / (Domestic + International). Excludes offshore.
	measure 'Avinor International Share' =
			DIVIDE (
			    [Avinor International Passengers],
			    [Avinor Domestic Passengers] + [Avinor International Passengers]
			)
		formatString: 0.0%
		displayFolder: 03 Norway (Avinor)
		lineageTag: 59e24efd-8a5f-4e18-9c17-224f7d8dde56

	/// N05. Helicopter passengers to offshore installations. Not in Eurostat airport totals.
	measure 'Avinor Offshore Passengers' = SUM ( FactAvinorMonthly[OffshorePax] )
		formatString: #,##0
		displayFolder: 03 Norway (Avinor)
		lineageTag: e48310e3-7436-401d-a738-168b9cf4a3a5

	/// N06. Share of fixed-wing passengers who transfer: (DomesticPaxTransfer + InternationalPaxTransfer) / (Domestic + International). Compare with Finavia HEL Transfer Share only as separate visuals.
	measure 'Avinor Transfer Share' =
			DIVIDE (
			    SUM ( FactAvinorMonthly[DomesticPaxTransfer] ) + SUM ( FactAvinorMonthly[InternationalPaxTransfer] ),
			    [Avinor Domestic Passengers] + [Avinor International Passengers]
			)
		formatString: 0.0%
		displayFolder: 03 Norway (Avinor)
		lineageTag: 26333716-3fc8-43b1-adeb-dbf38ef8da0b

	/// H01. Finavia Helsinki passengers: arriving, departing and transfer (Domestic + International rows). Annual only: use DimYear, never a month axis. Never add to Eurostat EFHK values.
	measure 'Finavia HEL Passengers' = SUM ( FactHelsinkiAnnual[TotalPassengers] )
		formatString: #,##0
		displayFolder: 04 Helsinki (Finavia)
		lineageTag: a45a5fd1-18a8-4013-85d1-0628159b9f21

	/// H02. Helsinki transfer passengers (published transfer column). Already inside Finavia HEL Passengers: never add the two.
	measure 'Finavia HEL Transfer Passengers' = SUM ( FactHelsinkiAnnual[TransferPassengers] )
		formatString: #,##0
		displayFolder: 04 Helsinki (Finavia)
		lineageTag: 4fba6eb0-fa52-4ad9-8c2c-2eb72ca772b9

	/// H03. Transfer passengers / total Helsinki passengers.
	measure 'Finavia HEL Transfer Share' = DIVIDE ( [Finavia HEL Transfer Passengers], [Finavia HEL Passengers] )
		formatString: 0.0%
		displayFolder: 04 Helsinki (Finavia)
		lineageTag: b7495050-f9de-42bd-95be-300a4c5fbc74

	/// H04. Helsinki passengers on domestic flights.
	measure 'Finavia HEL Domestic Passengers' =
			CALCULATE (
			    [Finavia HEL Passengers],
			    KEEPFILTERS ( FactHelsinkiAnnual[TrafficType] = "Domestic" )
			)
		formatString: #,##0
		displayFolder: 04 Helsinki (Finavia)
		lineageTag: eea5732c-cf2a-463a-b1d9-22579eda3ee1

	/// H05. Helsinki passengers on international flights.
	measure 'Finavia HEL International Passengers' =
			CALCULATE (
			    [Finavia HEL Passengers],
			    KEEPFILTERS ( FactHelsinkiAnnual[TrafficType] = "International" )
			)
		formatString: #,##0
		displayFolder: 04 Helsinki (Finavia)
		lineageTag: 13b95a16-eff2-412a-9517-c1f5af72ae54

	/// H06. Domestic passengers / all Helsinki passengers (TrafficType filter removed from the denominator).
	measure 'Finavia HEL Domestic Share' =
			DIVIDE (
			    [Finavia HEL Domestic Passengers],
			    CALCULATE ( [Finavia HEL Passengers], REMOVEFILTERS ( FactHelsinkiAnnual[TrafficType] ) )
			)
		formatString: 0.0%
		displayFolder: 04 Helsinki (Finavia)
		lineageTag: dcd5234e-9ac3-4aa5-95a8-6a2263122e4b

	/// R02. Helper: Network Passengers one year earlier (DimDate shifted, DimYear filter removed). Blank for 2022. Valid 2023-01 to 2024-12.
	measure 'Network Passengers PY' = CALCULATE ( [Network Passengers], DATEADD ( DimDate[Date], -1, YEAR ), REMOVEFILTERS ( DimYear ) )
		formatString: #,##0
		displayFolder: 02 Route Intelligence
		lineageTag: a2a5e056-4fa4-48f6-b2d2-cbb17c9a7730

	/// R05. Helper: current network passengers on flow-months that also have published data a year earlier, excluding reporting airports with partial coverage (D-R8). Confidential flows drop out automatically.
	measure 'Network Passengers LFL' =
			SUMX (
			    SUMMARIZE ( FactRouteMonthly, FactRouteMonthly[FlowKey], DimDate[MonthStart] ),
			    VAR Cur =
			        CALCULATE ( [Network Passengers], KEEPFILTERS ( FactRouteMonthly[DQ_ReportingAirportPartialCoverage] = FALSE () ) )
			    VAR Prev =
			        CALCULATE ( [Network Passengers PY], KEEPFILTERS ( FactRouteMonthly[DQ_ReportingAirportPartialCoverage] = FALSE () ) )
			    RETURN IF ( NOT ISBLANK ( Cur ) && NOT ISBLANK ( Prev ), Cur )
			)
		formatString: #,##0
		displayFolder: 02 Route Intelligence
		lineageTag: 3053164c-9754-4808-8c8a-81bdebe7a22f

	/// R06. Helper: prior-year network passengers on the same flow-months as Network Passengers LFL.
	measure 'Network Passengers PY LFL' =
			SUMX (
			    SUMMARIZE ( FactRouteMonthly, FactRouteMonthly[FlowKey], DimDate[MonthStart] ),
			    VAR Cur =
			        CALCULATE ( [Network Passengers], KEEPFILTERS ( FactRouteMonthly[DQ_ReportingAirportPartialCoverage] = FALSE () ) )
			    VAR Prev =
			        CALCULATE ( [Network Passengers PY], KEEPFILTERS ( FactRouteMonthly[DQ_ReportingAirportPartialCoverage] = FALSE () ) )
			    RETURN IF ( NOT ISBLANK ( Cur ) && NOT ISBLANK ( Prev ), Prev )
			)
		formatString: #,##0
		displayFolder: 02 Route Intelligence
		lineageTag: cf4d5515-67fe-454f-b055-b3479ff289cb

	/// R07. Like-for-like year-on-year change in route passengers (constant reporting panel). 2024: +5.9% like-for-like versus +7.3% on reported totals. Only 2023 and 2024.
	measure 'Route Passenger Growth YoY %' = DIVIDE ( [Network Passengers LFL] - [Network Passengers PY LFL], [Network Passengers PY LFL] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 02 Route Intelligence
		lineageTag: adf30506-2b32-4c2c-ac80-6cf4ada3af4f

	/// R22. Change in reported network passengers (R01) against the prior year, without the constant reporting panel. Use only beside Route Passenger Growth YoY % on the Data Quality page; label "reported totals, coverage changes included". Blank when either year has no route data (2022, 2025). 2023: +16.4%; 2024: +7.3%.
	measure 'Route Passenger Growth YoY % (Reported)' =
			VAR Cur = [Network Passengers]
			VAR Prev = [Network Passengers PY]
			RETURN IF ( NOT ISBLANK ( Cur ) && NOT ISBLANK ( Prev ), DIVIDE ( Cur - Prev, Prev ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 02 Route Intelligence
		lineageTag: 4238675e-a313-490f-8d92-34b7f443f522

	/// A06. Change in reported totals, without coverage adjustment. Use only beside Passenger Growth YoY % on the Data Quality page; label "reported totals, coverage changes included".
	measure 'Passenger Growth YoY % (Reported)' = DIVIDE ( [Total Passengers] - [Total Passengers PY], [Total Passengers PY] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01 Airport Performance
		lineageTag: db6bdb27-b0d9-4af8-9ece-5580f8318f29

	/// A13. Change in load factor against the same months a year earlier, in percentage points (valid rows only).
	measure 'Load Factor Change (pp)' =
			VAR Cur = [Passenger Load Factor]
			VAR Prev =
			    CALCULATE ( [Passenger Load Factor], DATEADD ( DimDate[Date], -1, YEAR ), REMOVEFILTERS ( DimYear ) )
			RETURN IF ( NOT ISBLANK ( Cur ) && NOT ISBLANK ( Prev ), ( Cur - Prev ) * 100 )
		formatString: +0.0" pp";-0.0" pp"
		displayFolder: 01 Airport Performance
		lineageTag: 129c36dc-07ab-4d85-ad95-3053ebd61594

	/// A14. Like-for-like change in commercial flights. Sweden Jan-Feb 2022 is excluded, so Jan-Feb 2023 Swedish pairs drop out of 2023 growth automatically.
	measure 'Commercial Flights Growth YoY %' =
			VAR T =
			    ADDCOLUMNS (
			        SUMMARIZE ( FactAirportMonthly, DimAirport[AirportICAO], DimDate[MonthStart] ),
			        "@Cur", [Commercial Flights],
			        "@Prev", CALCULATE ( [Commercial Flights], DATEADD ( DimDate[Date], -1, YEAR ), REMOVEFILTERS ( DimYear ) )
			    )
			VAR Cur = SUMX ( FILTER ( T, NOT ISBLANK ( [@Cur] ) && NOT ISBLANK ( [@Prev] ) ), [@Cur] )
			VAR Prev = SUMX ( FILTER ( T, NOT ISBLANK ( [@Cur] ) && NOT ISBLANK ( [@Prev] ) ), [@Prev] )
			RETURN DIVIDE ( Cur - Prev, Prev )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01 Airport Performance
		lineageTag: 7b1a73e7-428c-4ff6-add5-f36c9492c1d1

	/// N09. Helper: Avinor terminal passengers one year earlier (DimDate shifted, DimYear filter removed).
	measure 'Avinor Terminal Passengers PY' = CALCULATE ( [Avinor Terminal Passengers], DATEADD ( DimDate[Date], -1, YEAR ), REMOVEFILTERS ( DimYear ) )
		formatString: #,##0
		displayFolder: 03 Norway (Avinor)
		lineageTag: 2429c395-2db9-4eca-a334-d03654f0d507

	/// N10. Like-for-like change in Avinor terminal passengers: airport-month pairs with values in both years (excludes MQN July 2024 and July 2025 comparisons).
	measure 'Avinor Passenger Growth YoY %' =
			VAR T =
			    ADDCOLUMNS (
			        SUMMARIZE ( FactAvinorMonthly, DimAirport[AirportICAO], DimDate[MonthStart] ),
			        "@Cur", [Avinor Terminal Passengers],
			        "@Prev", [Avinor Terminal Passengers PY]
			    )
			VAR T2 = FILTER ( T, NOT ISBLANK ( [@Cur] ) && NOT ISBLANK ( [@Prev] ) )
			VAR Cur = SUMX ( T2, [@Cur] )
			VAR Prev = SUMX ( T2, [@Prev] )
			RETURN DIVIDE ( Cur - Prev, Prev )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Norway (Avinor)
		lineageTag: caed82ae-4ffb-47bd-a07e-90037aa649b9

	/// H07. Helper: Helsinki passengers in the previous year, for one selected year. Blank for 1998 and for multi-year selections.
	measure 'Finavia HEL Passengers PY' =
			VAR Y = MAX ( DimYear[Year] )
			RETURN
			    IF (
			        HASONEVALUE ( DimYear[Year] ),
			        CALCULATE ( [Finavia HEL Passengers], REMOVEFILTERS ( DimYear ), DimYear[Year] = Y - 1 )
			    )
		formatString: #,##0
		displayFolder: 04 Helsinki (Finavia)
		lineageTag: 8c9d987a-4993-448d-ac57-d4bd6a3164ee

	/// H08. Year-on-year change in Helsinki passengers. Coverage is constant (one airport), so no like-for-like adjustment is needed.
	measure 'Finavia HEL Growth YoY %' = DIVIDE ( [Finavia HEL Passengers] - [Finavia HEL Passengers PY], [Finavia HEL Passengers PY] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Helsinki (Finavia)
		lineageTag: 990d2615-1170-4004-bb71-1635bd507778

	/// H09. Compound annual growth rate between the first and last selected years with data. 1998-2025: +2.2% a year; 2022-2025: +9.6% a year.
	measure 'Finavia HEL CAGR (Selected Years)' =
			VAR Yrs = FILTER ( VALUES ( DimYear[Year] ), NOT ISBLANK ( [Finavia HEL Passengers] ) )
			VAR Y0 = MINX ( Yrs, DimYear[Year] )
			VAR Y1 = MAXX ( Yrs, DimYear[Year] )
			VAR P0 = CALCULATE ( [Finavia HEL Passengers], REMOVEFILTERS ( DimYear ), DimYear[Year] = Y0 )
			VAR P1 = CALCULATE ( [Finavia HEL Passengers], REMOVEFILTERS ( DimYear ), DimYear[Year] = Y1 )
			RETURN IF ( Y1 > Y0 && P0 > 0, POWER ( DIVIDE ( P1, P0 ), 1 / ( Y1 - Y0 ) ) - 1 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Helsinki (Finavia)
		lineageTag: 6be32ca1-332f-42f9-a237-d9cebd29c1de

	/// H10. Helsinki passengers as a share of the 2019 peak. 2025: 77.7%.
	measure 'Finavia HEL Recovery vs 2019' =
			DIVIDE (
			    [Finavia HEL Passengers],
			    CALCULATE ( [Finavia HEL Passengers], REMOVEFILTERS ( DimYear ), DimYear[Year] = 2019 )
			)
		formatString: 0.0%
		displayFolder: 04 Helsinki (Finavia)
		lineageTag: 36e524ea-4bdd-479d-b9fe-3bdc5b1f3d08

	/// A15. Average passengers on board per passenger flight on the same valid rows (aircraft size and loading).
	measure 'Passengers per Passenger Flight' =
			DIVIDE (
			    [Passengers On Board (LF basis)],
			    CALCULATE ( SUM ( FactAirportMonthly[PassengerFlights] ), KEEPFILTERS ( FactAirportMonthly[DQ_CapacityValidForLoadFactor] = TRUE () ) )
			)
		formatString: #,##0.0
		displayFolder: 01 Airport Performance
		lineageTag: c70e6677-ece9-4f6b-858a-779dba072976

	/// A16. Share of all 76 Nordic airports' passengers held by the selected airports or country (airport filters removed in the denominator). Airport-statistics convention.
	measure 'Nordic Passenger Share' = DIVIDE ( [Total Passengers], CALCULATE ( [Total Passengers], REMOVEFILTERS ( DimAirport ) ) )
		formatString: 0.0%
		displayFolder: 01 Airport Performance
		lineageTag: aa449216-956d-4c35-ac10-823dd11bbeb4

	/// A17. Rank of an airport by passengers within the visible selection; blank when the airport has no data. Use with DimAirport[InFactAirportMonthly] = TRUE as a visual filter.
	measure 'Airport Passenger Rank' =
			IF (
			    NOT ISBLANK ( [Total Passengers] ),
			    RANKX ( ALLSELECTED ( DimAirport[AirportName] ), [Total Passengers], , DESC, DENSE )
			)
		formatString: 0
		displayFolder: 01 Airport Performance
		lineageTag: 0f0ec7dc-2356-4f5b-a043-c468f23022f7

	/// A18. Number of airports with data in the selection (76, 73, 73, 72 by year).
	measure 'Airports Reporting' = DISTINCTCOUNT ( FactAirportMonthly[AirportICAO] )
		formatString: 0
		displayFolder: 01 Airport Performance
		lineageTag: 91bb80b1-4183-496d-84fc-791c37c25dff

	/// A19. Rank of the selected airport by passengers among all reporting Nordic airports (1 = most passengers; ties share a rank). Airport filters, including a drill-through filter, are removed for the peer set; date and year filters are kept. Blank unless exactly one airport with data is selected.
	measure 'Nordic Airport Passenger Rank' =
			VAR CurPax = [Total Passengers]
			RETURN
			    IF (
			        HASONEVALUE ( DimAirport[AirportName] ) && NOT ISBLANK ( CurPax ),
			        VAR Peers =
			            CALCULATETABLE (
			                ADDCOLUMNS ( VALUES ( DimAirport[AirportName] ), "@Pax", [Total Passengers] ),
			                REMOVEFILTERS ( DimAirport ),
			                DimAirport[InFactAirportMonthly] = TRUE ()
			            )
			        RETURN COUNTROWS ( FILTER ( Peers, [@Pax] > CurPax ) ) + 1
			    )
		formatString: \#0
		displayFolder: 01 Airport Performance
		lineageTag: 37179fee-c1ed-4037-9594-7f62bb00cb2d

	/// R08. Rank of a two-way route by network passengers in the visible selection. Use with visual filter DimRoute[IncludesUnknownAirport] = FALSE. Confidential routes have no rank (blank).
	measure 'Route Rank' =
			IF (
			    NOT ISBLANK ( [Network Passengers] ),
			    RANKX ( ALLSELECTED ( DimRoute[RouteName] ), [Network Passengers], , DESC, DENSE )
			)
		formatString: 0
		displayFolder: 02 Route Intelligence
		lineageTag: 742cdd64-fdfb-45d4-bde4-98cf93ee16be

	/// R09. Share of all selected network passengers on a route (route filters removed in the denominator). Share of published flows only.
	measure 'Route Share of Network' = DIVIDE ( [Network Passengers], CALCULATE ( [Network Passengers], REMOVEFILTERS ( DimRoute ) ) )
		formatString: 0.0%
		displayFolder: 02 Route Intelligence
		lineageTag: 0ce01869-e48e-4c71-b5f9-acd0fad27369

	/// R10. Two-way routes with traffic in the selection: primary rows with passengers > 0, flights > 0 or confidential values (MD-06).
	measure 'Routes Operated' =
			CALCULATE (
			    DISTINCTCOUNT ( FactRouteMonthly[RouteKey] ),
			    FILTER (
			        FactRouteMonthly,
			        FactRouteMonthly[IsPrimaryReport] = TRUE ()
			            && ( FactRouteMonthly[PassengersCarried] > 0
			                || FactRouteMonthly[PassengerFlights] > 0
			                || FactRouteMonthly[ValueStatus] = "Confidential" )
			    )
			)
		formatString: #,##0
		displayFolder: 02 Route Intelligence
		lineageTag: b8556913-7a0b-41a8-a2e2-ccbdf17e6acd

	/// R11. Destination airports reached from the selected origins over operated primary rows, excluding the unknown partner.
	measure 'Destinations Served' =
			CALCULATE (
			    DISTINCTCOUNT ( FactRouteMonthly[DestinationAirportICAO] ),
			    FILTER (
			        FactRouteMonthly,
			        FactRouteMonthly[IsPrimaryReport] = TRUE ()
			            && FactRouteMonthly[DestinationAirportICAO] <> "ZZZZ"
			            && ( FactRouteMonthly[PassengersCarried] > 0
			                || FactRouteMonthly[PassengerFlights] > 0
			                || FactRouteMonthly[ValueStatus] = "Confidential" )
			    )
			)
		formatString: #,##0
		displayFolder: 02 Route Intelligence
		lineageTag: 91d278b1-4949-4085-8190-11a97ecc2f80

	/// R12. Countries (ISO) reached from the selected origins over operated primary rows; the fact filter reaches DimDestinationAirport through the expanded table. Faroe Islands = FO.
	measure 'Destination Countries Served' =
			CALCULATE (
			    DISTINCTCOUNT ( DimDestinationAirport[DestinationISOCountryCode] ),
			    FILTER (
			        FactRouteMonthly,
			        FactRouteMonthly[IsPrimaryReport] = TRUE ()
			            && FactRouteMonthly[DestinationAirportICAO] <> "ZZZZ"
			            && ( FactRouteMonthly[PassengersCarried] > 0
			                || FactRouteMonthly[PassengerFlights] > 0
			                || FactRouteMonthly[ValueStatus] = "Confidential" )
			    )
			)
		formatString: #,##0
		displayFolder: 02 Route Intelligence
		lineageTag: c02945fd-7d52-4e0c-8b8f-d1b26e89e824

	/// R13. Network passengers on domestic routes. Understated: Norwegian domestic routes are confidential 2022-04 to 2024-12 (blank). Faroe Islands routes count as Danish domestic (Eurostat).
	measure 'Domestic Route Passengers' = CALCULATE ( [Network Passengers], KEEPFILTERS ( DimRoute[RouteScope] = "Domestic" ) )
		formatString: #,##0
		displayFolder: 02 Route Intelligence
		lineageTag: cfb2ebec-58ae-42d4-affb-c2d1ddb117be

	/// R14. Network passengers on cross-border routes between Sweden, Norway, Denmark and Finland. Published values only.
	measure 'Nordic Cross-Border Route Passengers' = CALCULATE ( [Network Passengers], KEEPFILTERS ( DimRoute[RouteScope] = "Cross-border within SE/NO/DK/FI" ) )
		formatString: #,##0
		displayFolder: 02 Route Intelligence
		lineageTag: 257a9b16-1ded-467a-a143-7fe4cd3e7da4

	/// R15. Network passengers on routes to and from countries outside the four Nordic countries. Published values only.
	measure 'International Route Passengers' = CALCULATE ( [Network Passengers], KEEPFILTERS ( DimRoute[RouteScope] = "International (outside SE/NO/DK/FI)" ) )
		formatString: #,##0
		displayFolder: 02 Route Intelligence
		lineageTag: 2c8f7d25-53a2-451f-a2bb-0d54930dc42c

	/// R16. Share of published route passengers on domestic routes. Label "published routes"; Norway domestic is missing, so do not compare countries on this measure.
	measure 'Domestic Share of Route Passengers' = DIVIDE ( [Domestic Route Passengers], [Network Passengers] )
		formatString: 0.0%
		displayFolder: 02 Route Intelligence
		lineageTag: 5e904b8b-6a6b-4318-b067-68f61a73f4ad

	/// R17. Domestic routes operated. Includes confidential Norwegian routes (MD-06).
	measure 'Domestic Routes Operated' = CALCULATE ( [Routes Operated], KEEPFILTERS ( DimRoute[RouteScope] = "Domestic" ) )
		formatString: #,##0
		displayFolder: 02 Route Intelligence
		lineageTag: 03f84133-b656-4f7c-8202-c70a6e1d51c5

	/// R18. Routes leaving the country (Nordic cross-border + outside the Nordics).
	measure 'International Routes Operated' =
			CALCULATE (
			    [Routes Operated],
			    KEEPFILTERS ( NOT ( DimRoute[RouteScope] IN { "Domestic", "Unknown partner" } ) )
			)
		formatString: #,##0
		displayFolder: 02 Route Intelligence
		lineageTag: 2a03ad4e-4a2a-4dc6-91d9-67b4f181ec5a

	/// R19. Commercial passenger flights on the selected flows: primary rows, Sweden Jan-Feb 2022 excluded.
	measure 'Route Passenger Flights' =
			CALCULATE (
			    SUM ( FactRouteMonthly[PassengerFlights] ),
			    KEEPFILTERS ( FactRouteMonthly[IsPrimaryReport] = TRUE () ),
			    KEEPFILTERS ( FactRouteMonthly[DQ_SE_JanFeb2022_FlightsSeatsIncomplete] = FALSE () )
			)
		formatString: #,##0
		displayFolder: 02 Route Intelligence
		lineageTag: 814ba34d-6ca9-4721-93b8-84dd1a74baae

	/// R20. PassengersOnBoard / PassengerSeatsAvailable on primary rows valid for load factor. Never use PassengersCarried with seats.
	measure 'Route Load Factor' =
			VAR Pax =
			    CALCULATE ( SUM ( FactRouteMonthly[PassengersOnBoard] ), KEEPFILTERS ( FactRouteMonthly[IsPrimaryReport] = TRUE () ), KEEPFILTERS ( FactRouteMonthly[DQ_CapacityValidForLoadFactor] = TRUE () ) )
			VAR Seats =
			    CALCULATE ( SUM ( FactRouteMonthly[PassengerSeatsAvailable] ), KEEPFILTERS ( FactRouteMonthly[IsPrimaryReport] = TRUE () ), KEEPFILTERS ( FactRouteMonthly[DQ_CapacityValidForLoadFactor] = TRUE () ) )
			RETURN DIVIDE ( Pax, Seats )
		formatString: 0.0%
		displayFolder: 02 Route Intelligence
		lineageTag: c2c3640c-e1a6-4415-aea8-d205b82517e0

	/// R21. Passenger-weighted average great-circle distance of the selected traffic (routes with a distance; not EKCH-ZZZZ). Great-circle estimate, not flown distance.
	measure 'Average Route Distance (km)' =
			VAR T = ADDCOLUMNS ( VALUES ( DimRoute[RouteKey] ), "@Pax", [Network Passengers], "@Km", CALCULATE ( MAX ( DimRoute[DistanceKm] ) ) )
			VAR T2 = FILTER ( T, NOT ISBLANK ( [@Pax] ) && NOT ISBLANK ( [@Km] ) )
			RETURN DIVIDE ( SUMX ( T2, [@Pax] * [@Km] ), SUMX ( T2, [@Pax] ) )
		formatString: #,##0
		displayFolder: 02 Route Intelligence
		lineageTag: 95e40d73-3524-4443-892b-627977e136b7

	/// N08. All Avinor movements including other civil aviation (secondary to Avinor Flight Movements). Never add to its parts.
	measure 'Avinor Total Movements' = SUM ( FactAvinorMonthly[TotalMovements] )
		formatString: #,##0
		displayFolder: 03 Norway (Avinor)
		lineageTag: 7e57d6b8-18d2-4e38-9744-154adf3c3b2d

	/// N11. Data-trust helper: Domestic + International, the Avinor figure comparable with Eurostat PassengersCarried. Comparison only.
	measure 'Avinor Passengers Excl Offshore' = [Avinor Domestic Passengers] + [Avinor International Passengers]
		formatString: #,##0
		displayFolder: 03 Norway (Avinor)
		lineageTag: 965de057-0af1-42f9-9e56-070758415dd8

	/// N12. Avinor passengers (excl. offshore) / Eurostat PassengersCarried for the 26 airports in both sources. A ratio, never a sum. 0.997 to 1.003 by year.
	measure 'Avinor vs Eurostat Ratio' =
			VAR Both =
			    CALCULATETABLE (
			        VALUES ( DimAirport[AirportICAO] ),
			        DimAirport[InFactAirportMonthly] = TRUE (),
			        DimAirport[InFactAvinorMonthly] = TRUE ()
			    )
			RETURN DIVIDE (
			    CALCULATE ( [Avinor Passengers Excl Offshore], Both ),
			    CALCULATE ( [Total Passengers], Both )
			)
		formatString: 0.000
		displayFolder: 03 Norway (Avinor)
		lineageTag: d672557a-279d-451d-af1e-33dec55e3974

	/// N13. Avinor airports with published terminal passengers.
	measure 'Avinor Airports With Data' = CALCULATE ( DISTINCTCOUNT ( FactAvinorMonthly[AirportICAO] ), NOT ISBLANK ( FactAvinorMonthly[TerminalPax] ) )
		formatString: 0
		displayFolder: 03 Norway (Avinor)
		lineageTag: d51f4eb5-30d4-46f2-b9a5-8bd48d771925

	/// N14. Avinor terminal passengers in a month as an index, 2022 monthly average = 100, for the same airport selection. Monthly axis only (blank above month level). Base approved as the 2022 average because January 2022 was depressed by COVID-19 restrictions.
	measure 'Avinor Passenger Index (2022 = 100)' =
			VAR Cur = [Avinor Terminal Passengers]
			VAR Base =
			    CALCULATE (
			        AVERAGEX ( VALUES ( DimDate[YearMonth] ), [Avinor Terminal Passengers] ),
			        REMOVEFILTERS ( DimDate ),
			        REMOVEFILTERS ( DimYear ),
			        DimYear[Year] = 2022
			    )
			RETURN
			    IF ( HASONEVALUE ( DimDate[YearMonth] ) && NOT ISBLANK ( Cur ), DIVIDE ( Cur, Base ) * 100 )
		formatString: 0.0
		displayFolder: 03 Norway (Avinor)
		lineageTag: a99efc50-3e15-402e-914d-d9f4434b1020

	/// N15. Avinor commercial flight movements in a month as an index, 2022 monthly average = 100, for the same airport selection. Monthly axis only (blank above month level). Base approved as the 2022 average because January 2022 was depressed by COVID-19 restrictions.
	measure 'Avinor Movement Index (2022 = 100)' =
			VAR Cur = [Avinor Flight Movements]
			VAR Base =
			    CALCULATE (
			        AVERAGEX ( VALUES ( DimDate[YearMonth] ), [Avinor Flight Movements] ),
			        REMOVEFILTERS ( DimDate ),
			        REMOVEFILTERS ( DimYear ),
			        DimYear[Year] = 2022
			    )
			RETURN
			    IF ( HASONEVALUE ( DimDate[YearMonth] ) && NOT ISBLANK ( Cur ), DIVIDE ( Cur, Base ) * 100 )
		formatString: 0.0
		displayFolder: 03 Norway (Avinor)
		lineageTag: c8d72117-5071-4b8e-8623-f1d1c7b5349c

	/// N16. Like-for-like change in Avinor international passengers: airport-month pairs with international values in both years (same method as N10). Blank for 2022.
	measure 'Avinor International Growth YoY %' =
			VAR T =
			    ADDCOLUMNS (
			        SUMMARIZE ( FactAvinorMonthly, DimAirport[AirportICAO], DimDate[MonthStart] ),
			        "@Cur", [Avinor International Passengers],
			        "@Prev", CALCULATE ( [Avinor International Passengers], DATEADD ( DimDate[Date], -1, YEAR ), REMOVEFILTERS ( DimYear ) )
			    )
			VAR T2 = FILTER ( T, NOT ISBLANK ( [@Cur] ) && NOT ISBLANK ( [@Prev] ) )
			VAR Cur = SUMX ( T2, [@Cur] )
			VAR Prev = SUMX ( T2, [@Prev] )
			RETURN DIVIDE ( Cur - Prev, Prev )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Norway (Avinor)
		lineageTag: 726bfdf1-6c2c-4d22-ac62-0208feb726aa

	/// H11. Finavia Helsinki total / Eurostat EFHK PassengersOnBoard for the same year (DimYear filters both). Years 2022-2025 only, on a year axis. 0.993 to 0.994 (Finavia excludes infants). A ratio, never a sum.
	measure 'Finavia vs Eurostat EFHK Ratio' =
			DIVIDE (
			    [Finavia HEL Passengers],
			    CALCULATE ( SUM ( FactAirportMonthly[PassengersOnBoard] ), KEEPFILTERS ( DimAirport[AirportICAO] = "EFHK" ) )
			)
		formatString: 0.000
		displayFolder: 04 Helsinki (Finavia)
		lineageTag: 637e697b-e57a-4e4c-8868-377a0624adbe

	/// Q01. Airport-months in the selection without a prior-year value (left out of like-for-like growth). 2023: 5, 2024: 10, 2025: none. Valid 2023-2025.
	measure 'Airport-Months Excluded from Growth' =
			SUMX (
			    SUMMARIZE ( FactAirportMonthly, DimAirport[AirportICAO], DimDate[MonthStart] ),
			    IF ( NOT ISBLANK ( [Total Passengers] ) && ISBLANK ( [Total Passengers PY] ), 1 )
			)
		formatString: 0
		displayFolder: 05 Data Quality & Coverage
		lineageTag: c79b916e-e517-42ed-8943-1ed21e788898

	/// Q02. Airport-months left out of load factor (DQ_CapacityValidForLoadFactor = FALSE). 79 in total.
	measure 'Capacity-Invalid Airport-Months' = CALCULATE ( COUNTROWS ( FactAirportMonthly ), KEEPFILTERS ( FactAirportMonthly[DQ_CapacityValidForLoadFactor] = FALSE () ) )
		formatString: 0
		displayFolder: 05 Data Quality & Coverage
		lineageTag: 651ffd8c-aa4a-417e-bda5-d9a77901da88

	/// Q03. Flow-months whose values Eurostat keeps confidential (shown as blank): primary rows with ValueStatus = Confidential. 2022: 1,148; 2023: 1,505; 2024: 1,429 (all Norwegian domestic).
	measure 'Confidential Route-Months' =
			CALCULATE (
			    COUNTROWS ( FactRouteMonthly ),
			    KEEPFILTERS ( FactRouteMonthly[IsPrimaryReport] = TRUE () ),
			    KEEPFILTERS ( FactRouteMonthly[ValueStatus] = "Confidential" )
			)
		formatString: #,##0
		displayFolder: 05 Data Quality & Coverage
		lineageTag: 1234f032-6185-417c-bea3-fdf44a503e35

	/// Q04. Route passengers on board (airport view, R04 via USERELATIONSHIP) as a share of airport passengers on board, for the same reporting airports and months. 2024 overall: 70.7%. Explains why route totals are lower than airport totals.
	measure 'Route Coverage of Airport Traffic' =
			VAR Pairs =
			    CALCULATETABLE (
			        SUMMARIZE ( FactRouteMonthly, FactRouteMonthly[ReportingAirportICAO], FactRouteMonthly[MonthStart] ),
			        USERELATIONSHIP ( DimAirport[AirportICAO], FactRouteMonthly[ReportingAirportICAO] )
			    )
			VAR RoutePOB =
			    CALCULATE ( SUM ( FactRouteMonthly[PassengersOnBoard] ), USERELATIONSHIP ( DimAirport[AirportICAO], FactRouteMonthly[ReportingAirportICAO] ) )
			VAR AirportPOB =
			    CALCULATE ( SUM ( FactAirportMonthly[PassengersOnBoard] ), TREATAS ( Pairs, FactAirportMonthly[AirportICAO], FactAirportMonthly[MonthStart] ) )
			RETURN DIVIDE ( RoutePOB, AirportPOB )
		formatString: 0.0%
		displayFolder: 05 Data Quality & Coverage
		lineageTag: 0ac7dbb9-6602-474d-81ff-9a8c4cb5ea5a

	/// Q05. Reporting airports with route rows in fewer than 36 months (EFTU, EFVA, ESMX). Excluded from route growth.
	measure 'Partial-Coverage Reporting Airports' = CALCULATE ( DISTINCTCOUNT ( FactRouteMonthly[ReportingAirportICAO] ), KEEPFILTERS ( FactRouteMonthly[DQ_ReportingAirportPartialCoverage] = TRUE () ) )
		formatString: 0
		displayFolder: 05 Data Quality & Coverage
		lineageTag: 7f948d3d-b7ef-4f70-807f-5a4bb06c562b

	/// Q06. Avinor airport-months with no published passenger figure: 1 (Mo i Rana, July 2024).
	measure 'Avinor Airport-Months Without Passengers' = CALCULATE ( COUNTROWS ( FactAvinorMonthly ), ISBLANK ( FactAvinorMonthly[TerminalPax] ) )
		formatString: 0
		displayFolder: 05 Data Quality & Coverage
		lineageTag: 159d734d-82ed-4b3e-b64a-91738e6be493

	/// Q07. Latest month in the route fact, with date and year filters removed: Dec 2024.
	measure 'Last Month With Route Data' = CALCULATE ( MAX ( FactRouteMonthly[MonthStart] ), REMOVEFILTERS ( DimDate ), REMOVEFILTERS ( DimYear ) )
		formatString: mmm yyyy
		displayFolder: 05 Data Quality & Coverage
		lineageTag: 868831b5-ff9c-43e2-8352-103c9364e545

	/// L01. Text for page subtitles from the DimYear selection, for example "2025" or "2023 to 2025".
	measure 'Selected Period Label' =
			VAR Y0 = MIN ( DimYear[Year] )
			VAR Y1 = MAX ( DimYear[Year] )
			RETURN IF ( Y0 = Y1, FORMAT ( Y0, "0" ), FORMAT ( Y0, "0" ) & " to " & FORMAT ( Y1, "0" ) )
		displayFolder: 06 Labels & Helpers
		lineageTag: 749b0d05-7de1-49b3-aec8-72cd2a9dff4e

	/// L02. Warning text shown on route visuals when the selected years include 2025.
	measure 'Route Data Note' = IF ( MAX ( DimYear[Year] ) >= 2025, "Route data ends in December 2024; 2025 has no route values." )
		displayFolder: 06 Labels & Helpers
		lineageTag: 00d2a518-c82f-48c1-b093-de008a1180e5

	/// L03. Tooltip text for growth KPIs: the like-for-like rule and the excluded count.
	measure 'Growth Coverage Note' = "Like-for-like: " & FORMAT ( [Airport-Months Excluded from Growth] + 0, "0" ) & " airport-months without a prior-year value excluded."
		displayFolder: 06 Labels & Helpers
		lineageTag: d2b16923-4959-42b2-8043-c4d747c99396

	/// L04. Shown on Norwegian route visuals when confidential route-months exist in the selection.
	measure 'Norway Route Confidential Note' =
			IF (
			    [Confidential Route-Months] > 0,
			    FORMAT ( [Confidential Route-Months], "#,##0" ) & " Norwegian domestic route-months are confidential (blank, not zero)."
			)
		displayFolder: 06 Labels & Helpers
		lineageTag: a93d4af3-f79c-4469-986f-02e3681d6fa4

	column Value
		isHidden
		lineageTag: 7a48097f-099c-47ea-abdd-06b2f490b508
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

	partition _Measures = calculated
		mode: import
		source = FILTER ( { BLANK () }, FALSE () )

