/// Year dimension 1998-2025 (28 rows). Step 3A Section 7.3, MD-04. Filters DimDate (R11) and FactHelsinkiAnnual (R12) once relationships are created.
table DimYear
	lineageTag: 45bed1b9-b12e-4fed-9ff7-ac7b4fec1675

	column Year
		dataType: int64
		isNullable: false
		formatString: 0
		lineageTag: a0a1545f-0b8a-4df1-8ff9-a450ec06a16b
		summarizeBy: none
		sourceColumn: Year

	column InAnalysisWindow
		dataType: boolean
		lineageTag: b942846d-419e-4c5f-bd06-2845a90218c3
		summarizeBy: none
		sourceColumn: InAnalysisWindow

	column HasEurostatAirportData
		dataType: boolean
		lineageTag: f32d55a7-0b1a-4fc4-909f-b7a078f45e85
		summarizeBy: none
		sourceColumn: HasEurostatAirportData

	column HasRouteData
		dataType: boolean
		lineageTag: dd3da0c8-7c60-4e47-8921-488961e2b55c
		summarizeBy: none
		sourceColumn: HasRouteData

	column HasAvinorData
		dataType: boolean
		lineageTag: cc06ab6a-666d-468f-a4e5-38545b23d4cd
		summarizeBy: none
		sourceColumn: HasAvinorData

	column HasHelsinkiData
		dataType: boolean
		lineageTag: 106afd38-a734-410d-97cb-b54ba18c37ef
		summarizeBy: none
		sourceColumn: HasHelsinkiData

	column Decade
		dataType: string
		lineageTag: 1daa3373-4797-44fd-8ed0-ecced5210a96
		summarizeBy: none
		sourceColumn: Decade

	partition DimYear = m
		mode: import
		source =
				let
				    Years = {1998..2025},
				    Rows = List.Transform(Years, (y as number) =>
				        [
				            Year = y,
				            InAnalysisWindow = y >= 2022 and y <= 2025,
				            HasEurostatAirportData = y >= 2022 and y <= 2025,
				            HasRouteData = y >= 2022 and y <= 2024,
				            HasAvinorData = y >= 2022 and y <= 2025,
				            HasHelsinkiData = y >= 1998 and y <= 2025,
				            Decade = Text.From(Number.IntegerDivide(y, 10) * 10) & "s"
				        ]),
				    DimYear = Table.FromRecords(Rows, type table [
				        Year = Int64.Type, InAnalysisWindow = logical, HasEurostatAirportData = logical,
				        HasRouteData = logical, HasAvinorData = logical, HasHelsinkiData = logical, Decade = text])
				in
				    DimYear

