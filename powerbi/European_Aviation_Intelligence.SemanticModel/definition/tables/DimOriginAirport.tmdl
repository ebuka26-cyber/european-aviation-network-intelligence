/// Role-playing origin airport dimension: Power Query reference of DimAirport, rows with InFactRouteMonthly = TRUE (185), columns prefixed Origin. Relates only to FactRouteMonthly[OriginAirportICAO] (R05, Step 3B-3).
table DimOriginAirport
	lineageTag: 9e124efe-4d14-41b9-8683-38dc604858c4

	column OriginAirportICAO
		dataType: string
		isNullable: false
		lineageTag: b1692de6-f08e-48a9-b82e-0271aab4dc1b
