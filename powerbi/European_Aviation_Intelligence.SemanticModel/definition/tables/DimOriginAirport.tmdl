	partition DimOriginAirport = m
		mode: import
		source =
				let
				    Source = DimAirport,
				    Rows = Table.SelectRows(Source, each [InFactRouteMonthly] = true),
				    Kept = Table.SelectColumns(Rows, {"AirportICAO", "AirportIATA", "AirportName", "CountryCode", "CountryName",
				        "Municipality", "Latitude", "Longitude", "EurostatCountryCode", "ContinentCode",
				        "IsRouteReportingAirport", "IsUnknownMember"}),
				    Renamed = Table.RenameColumns(Kept, {
				        {"AirportICAO", "OriginAirportICAO"}, {"AirportIATA", "OriginAirportIATA"},
				        {"AirportName", "OriginAirportName"}, {"CountryCode", "OriginISOCountryCode"},
				        {"CountryName", "OriginCountryName"}, {"Municipality", "OriginMunicipality"},
				        {"Latitude", "OriginLatitude"}, {"Longitude", "OriginLongitude"},
				        {"EurostatCountryCode", "OriginEurostatCountryCode"}, {"ContinentCode", "OriginContinentCode"},
				        {"IsRouteReportingAirport", "OriginIsReportingAirport"}, {"IsUnknownMember", "OriginIsUnknown"}})
				in
				    Renamed

