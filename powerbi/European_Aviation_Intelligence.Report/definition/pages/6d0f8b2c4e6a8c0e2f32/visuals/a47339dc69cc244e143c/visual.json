    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Passengers carried vs on board (Eurostat). ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10px",
                      "color": "#1f1f1d"
                    }
                  },
                  {
                    "value": "Carried counts a passenger once per flight number (headline); on board counts every flight stage and is used only with seats.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10px",
                      "color": "#3d3d3a"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Avinor terminal passengers. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10px",
                      "color": "#1f1f1d"
                    }
                  },
                  {
                    "value": "Arriving, departing and transfer passengers incl. infants and offshore helicopter traffic; transit passengers who stay on board are separate.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10px",
                      "color": "#3d3d3a"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Finavia transfer counting. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10px",
                      "color": "#1f1f1d"
                    }
                  },
                  {
                    "value": "Total = arrivals + departures + transfers: a transfer passenger counts once arriving and once departing, as in Eurostat; infants are excluded.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10px",
                      "color": "#3d3d3a"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
