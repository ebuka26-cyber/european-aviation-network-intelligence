    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read this page",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11px",
                      "color": "#1f1f1d"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Follows the Year slicer: ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9px",
                      "color": "#1f1f1d"
                    }
                  },
                  {
                    "value": "the six cards and the growth and trust tables. The coverage matrix and the rules are fixed.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9px",
                      "color": "#3d3d3a"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Flags, not edits: ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9px",
                      "color": "#1f1f1d"
                    }
                  },
                  {
                    "value": "flags mark issues and decide which rows a measure uses; no source value was changed.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9px",
                      "color": "#3d3d3a"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Blank is not zero: ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9px",
                      "color": "#1f1f1d"
                    }
                  },
                  {
                    "value": "blank cells mean no data or not comparable. Growth starts in 2023 because 2022 has no prior year.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9px",
                      "color": "#3d3d3a"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Routes end in 2024: ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9px",
                      "color": "#1f1f1d"
                    }
                  },
                  {
                    "value": "route measures show n/a for 2025, and Norwegian domestic routes are confidential (blank).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9px",
                      "color": "#3d3d3a"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Data trust: ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9px",
                      "color": "#1f1f1d"
                    }
                  },
                  {
                    "value": "Avinor is within 0.3% of Eurostat; Finavia is 0.6 to 0.7% lower because it excludes infants.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9px",
                      "color": "#3d3d3a"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
      ]
